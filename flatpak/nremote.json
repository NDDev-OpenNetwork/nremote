{
  "id": "com.nremote.NRemote",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "nremote",
  "cleanup": ["/include", "/lib/pkgconfig", "/share/gtk-doc"],
  "rename-desktop-file": "nremote.desktop",
  "rename-icon": "nremote",
  "modules": [
    "shared-modules/libappindicator/libappindicator-gtk3-12.10.json",
    {
      "name": "xdotool",
      "no-autogen": true,
      "make-install-args": ["PREFIX=${FLATPAK_DEST}"],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/jordansissel/xdotool/releases/download/v3.20211022.1/xdotool-3.20211022.1.tar.gz",
          "sha256": "96f0facfde6d78eacad35b91b0f46fecd0b35e474c03e00e30da3fdd345f9ada"
        }
      ]
    },
    {
      "name": "nremote",
      "buildsystem": "simple",
      "build-commands": [
        "bsdtar -Oxf nremote.deb data.tar.xz | bsdtar -xf -",
        "cp -r usr/* /app/",
        "mkdir -p /app/bin && ln -s /app/share/nremote/nremote /app/bin/nremote"
      ],
      "sources": [
        {
          "type": "file",
          "path": "nremote.deb"
        },
        {
          "type": "file",
          "path": "com.nremote.NRemote.metainfo.xml"
        }
      ]
    }
  ],
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=x11",
    "--share=network",
    "--filesystem=home",
    "--device=dri",
    "--socket=pulseaudio",
    "--talk-name=org.freedesktop.Flatpak"
  ]
}
